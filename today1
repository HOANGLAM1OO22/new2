# ✅ 3️⃣ HEVC Matcher (đã sửa đúng)

```kotlin
class HevcCSDMatcher : CSDMatcher {

    override fun match(first: ByteBuffer, second: ByteBuffer): Boolean {
        val sps1 = parseHevcSps(first)
        val sps2 = parseHevcSps(second)

        return sps1.isCodecCompatible(sps2)
    }

    private fun parseHevcSps(buffer: ByteBuffer): HevcSpsData {
        val data = ByteArray(buffer.remaining())
        buffer.get(data)

        // remove start code nếu có
        val unescapedLength = NalUnitUtil.unescapeStream(data, 0, data.size)
        val unescaped = data.copyOf(unescapedLength)

        val bitArray = ParsableBitArray(unescaped)

        bitArray.skipBits(16) // NAL header

        return HevcSpsParser.parse(bitArray)
    }
}
```

