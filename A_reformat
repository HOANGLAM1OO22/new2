1. getOverlappingSection()

Logic:

Duyệt danh sách Motion Photo đã sort theo thời gian.

Lấy duration thực từ video/audio track.

Tính currentFileEndTimeMs.

So với file trước đó.

Nếu overlap → chỉ lấy phần không overlap.

Nếu bị overlap hoàn toàn → bỏ qua.


public static LinkedHashSet<SectionInfo> getOverlappingSection(
        @NonNull LinkedHashSet<ItemInfo> itemList) {

    Log.d(TAG, "getOverlappingSection");

    long start = System.nanoTime();

    LinkedHashSet<SectionInfo> result = new LinkedHashSet<>();

    long prevFileEndTimeMs = 0;
    long prevFileDuration = 0;

    int processedImages = 0;

    ItemInfo prevItemInfo = null;

    for (ItemInfo currentItemInfo : itemList) {

        long currentFileDuration;
        long currentFileEndTimeMs;

        /*
         * Get real duration from video/audio track
         */
        VideoInfo info = getVideoDataPosition(currentItemInfo.file);

        if (info != null && info.getVideoLength() > 0) {

            Map<String, Long> fileInfo = getTrackDuration(
                    info.getVideoOffset(),
                    info.getVideoLength(),
                    currentItemInfo.file
            );

            Long videoDuration = fileInfo.get("mp-video-duration");
            Long audioDuration = fileInfo.get("mp-audio-duration");

            if (videoDuration != null && audioDuration != null) {

                /*
                 * Audio/video duration may differ slightly.
                 * Use the shorter one.
                 */
                currentFileDuration =
                        Math.min(videoDuration, audioDuration) / 1000;

            } else {
                currentFileDuration = currentItemInfo.duration;
            }

        } else {
            currentFileDuration = currentItemInfo.duration;
        }

        long exifDateTimeOriginal =
                currentItemInfo.exifDateTimeOriginalMs;

        long presentationTimestampMs =
                getEDMPTimestamp(currentItemInfo.file) / 1000;

        if (presentationTimestampMs > currentFileDuration) {
            presentationTimestampMs = currentFileDuration;
        }

        if (presentationTimestampMs + 200 < currentFileDuration) {

            currentFileEndTimeMs =
                    exifDateTimeOriginal
                            + (currentFileDuration
                            - presentationTimestampMs);

        } else {

            currentFileEndTimeMs = exifDateTimeOriginal;
        }

        Log.d(TAG,
                "[file=" + currentItemInfo.file +
                        ", endTime=" + currentFileEndTimeMs +
                        ", duration=" + currentFileDuration + "]");

        /*
         * First item
         */
        if (prevItemInfo == null) {

            result.add(new SectionInfo(
                    currentItemInfo.file,
                    0,
                    currentFileDuration));

            Log.d(TAG,
                    "startPos=0, endPos=" + currentFileDuration);

            processedImages++;

            prevFileDuration = currentFileDuration;
            prevFileEndTimeMs = currentFileEndTimeMs;
            prevItemInfo = currentItemInfo;

            continue;
        }

        long diff = currentFileEndTimeMs - prevFileEndTimeMs;

        if (diff > 0) {

            long currentFileStartTimeMs =
                    currentFileEndTimeMs - currentFileDuration;

            if (currentFileStartTimeMs < prevFileEndTimeMs) {

                long notOverlapped =
                        currentFileEndTimeMs - prevFileEndTimeMs;

                long startPos =
                        currentFileDuration - notOverlapped;

                result.add(new SectionInfo(
                        currentItemInfo.file,
                        startPos,
                        currentFileDuration));

                Log.d(TAG,
                        "startPos=" + startPos +
                                ", endPos=" + currentFileDuration);

            } else {

                result.add(new SectionInfo(
                        currentItemInfo.file,
                        0,
                        currentFileDuration));

                Log.d(TAG,
                        "startPos=0, endPos=" + currentFileDuration);
            }

            processedImages++;

            prevFileDuration = currentFileDuration;
            prevFileEndTimeMs = currentFileEndTimeMs;
            prevItemInfo = currentItemInfo;

        } else {

            Log.d(TAG,
                    "Current motion photo overlapped completely. Skip.");
        }
    }

    long end = System.nanoTime();

    Log.d(TAG,
            "executing time="
                    + (end - start) / 1_000_000
                    + " ms, total image="
                    + processedImages);

    return result;
}


