3. writeTrack()

Logic:

Lấy từng MediaCodecChannel.

Bỏ track không cần mux.

Ghi sample vào muxer.

Cập nhật first/last timestamp.


fun writeTrack(
    numChannel: Int,
    source: MPFile,
    channels: BlockingQueue<MediaCodecChannel>
): Result {

    SLog.i(
        TAG,
        "writeTrack: numChannel=$numChannel, source=${source.path()}, channels=${channels.size}"
    )

    var firstTimestampUs = Long.MAX_VALUE
    var lastTimestampUs = 0L

    val firstTransferTimestampUs = 0L

    val lastTransferTimestampUs =
        if (lastTransferTimestampUs == 0L) {
            source.getDistinctLastTimestampUs()
        } else {
            lastTransferTimestampUs
        }

    repeat(numChannel) {

        val channel = channels.take()

        SLog.i(TAG, "getChannel: ${channel.mimeType}")

        if (targetMimeTypes.any {
                channel.mimeType.value.startsWith(it)
            }) {

            SLog.w(
                TAG,
                "target mime type ${channel.mimeType}, skip"
            )

            return@repeat
        }

        val mimeType = channel.mimeType.value
        val (muxTrackIndex, _) = trackInfos[mimeType]!!

        while (true) {

            val buffer = channel.take()

            val bufferInfo = buffer.info
            val byteBuffer = buffer.data

            when {

                bufferInfo.flags and
                        MediaCodec.BUFFER_FLAG_END_OF_STREAM != 0 -> {

                    SLog.d(TAG, "EOS reached")
                    break
                }

                bufferInfo.presentationTimeUs <
                        firstTransferTimestampUs -> {

                    SLog.d(
                        TAG,
                        """
                        Skip frame
                        track=$muxTrackIndex
                        ${bufferInfo.asString()}
                        lastTransferTimestampUs=$lastTransferTimestampUs
                        """.trimIndent()
                    )

                    continue
                }
            }

            muxer.writeSampleData(
                muxTrackIndex,
                byteBuffer,
                bufferInfo
            )

            byteBuffer.rewind()

            firstTimestampUs =
                minOf(firstTimestampUs,
                    bufferInfo.presentationTimeUs)

            lastTimestampUs =
                maxOf(lastTimestampUs,
                    bufferInfo.presentationTimeUs)

            eventListener?.onEachFrameTransferred(
                source,
                mimeType,
                bufferInfo
            )
        }
    }

    return Result.success()
}


