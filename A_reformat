2. prepareMotionPhotoInfo()

Logic:

1. Sort ảnh theo DateTaken.


2. Load duration.


3. Tính section overlap.


4. Tạo KenBurnMap mới.


5. Tính total duration.



private void prepareMotionPhotoInfo(
        EncodeInfo encodeInfo,
        Consumer<Boolean> prepared,
        AtomicBoolean interrupt) {

    showDialog();

    SimpleThreadPool.getInstance().submit(() -> {

        TimeTickLog tickLog =
                new TimeTickLog(TAG, "prepareMotionPhotoInfo");

        List<ThumbnailInterface> list =
                encodeInfo.kenBurnsMap.keySet()
                        .stream()
                        .sorted(Comparator.comparingLong(
                                ThumbnailInterface::getDateTaken))
                        .collect(Collectors.toList());

        List<MotionPhotoUtils.SectionInfo> infos =
                new ArrayList<>();

        for (ThumbnailInterface item : list) {

            if (interrupt.get()) {
                prepared.accept(false);
                return;
            }

            MotionPhotoUtils.SectionInfo info =
                    new MotionPhotoUtils.SectionInfo();

            info.filePath = item.getPath();
            info.dateTaken = item.getDateTaken();
            info.duration =
                    MetadataManager.getInstance()
                            .load(item)
                            .duration;

            infos.add(info);
        }

        tickLog.tick("loadVideoInfo");

        List<MotionPhotoUtils.SectionInfo> sections =
                MotionPhotoUtils.getOverlappingSection(infos);

        tickLog.tick("loadSections");

        LinkedHashMap<ThumbnailInterface, KenBurnsInfo> newKenBurnMap =
                new LinkedHashMap<>();

        HashMap<ThumbnailInterface, Pair<Long, Long>> sectionInfoMap =
                new HashMap<>();

        int totalDuration = 0;

        for (MotionPhotoUtils.SectionInfo section : sections) {

            int duration =
                    (int) (section.endPosition
                            - section.startPosition);

            totalDuration += duration;

            ThumbnailInterface item =
                    list.stream()
                            .filter(i ->
                                    i.getPath().equals(section.filePath))
                            .findAny()
                            .orElse(null);

            if (item == null) {
                continue;
            }

            KenBurnsInfo info =
                    encodeInfo.kenBurnsMap.get(item);

            if (info != null) {

                info.getTransitionInProperty()
                        .setDelay(
                                duration > 1500
                                        ? (float) (duration - 750)
                                        / duration
                                        : 1f
                        );

                info.setInitAlpha(0f)
                        .setTargetAlpha(1f);

                newKenBurnMap.put(item, info);

                sectionInfoMap.put(
                        item,
                        new Pair<>(
                                section.startPosition,
                                section.endPosition
                        ));
            }
        }

        encodeInfo
                .setDuration(totalDuration)
                .setKenBurnMap(newKenBurnMap)
                .setSectionInfoMap(sectionInfoMap);

        tickLog.tock();

        boolean success = totalDuration > 0;

        ThreadUtil.runOnUiThread(
                () -> prepared.accept(success));

        Log.d(TAG,
                "prepareMotionPhotoInfo result: duration="
                        + totalDuration
                        + ", sectionSize="
                        + sections.size()
                        + ", originSize="
                        + list.size());
    });
}


