3. Parse PPS

fun parsePpsNalUnit(nal: ByteArray): PpsData {

    val unescapedLength =
        NalUnitUtil.unescapeStream(nal, nal.size)

    val bitArray =
        ParsableNalUnitBitArray(
            nal,
            1,
            unescapedLength
        )

    val ppsId =
        bitArray.readUnsignedExpGolombCodedInt()

    val spsId =
        bitArray.readUnsignedExpGolombCodedInt()

    val entropyCodingModeFlag =
        bitArray.readBit()

    val bottomFieldPicOrderInFramePresentFlag =
        bitArray.readBit()

    val numSliceGroupsMinus1 =
        bitArray.readUnsignedExpGolombCodedInt()

    // skip slice groups (rare)
    if (numSliceGroupsMinus1 > 0) {
        // not fully implemented
    }

    val weightedPredFlag =
        bitArray.readBit()

    val weightedBipredIdc =
        bitArray.readBits(2)

    val picInitQpMinus26 =
        bitArray.readSignedExpGolombCodedInt()

    val picInitQsMinus26 =
        bitArray.readSignedExpGolombCodedInt()

    val chromaQpIndexOffset =
        bitArray.readSignedExpGolombCodedInt()

    val deblockingFilterControlPresentFlag =
        bitArray.readBit()

    val constrainedIntraPredFlag =
        bitArray.readBit()

    val redundantPicCntPresentFlag =
        bitArray.readBit()

    var transform8x8ModeFlag = false
    var secondChromaQpIndexOffset = 0

    if (bitArray.canReadBits(1)) {

        transform8x8ModeFlag =
            bitArray.readBit()

        val picScalingMatrixPresentFlag =
            bitArray.readBit()

        if (picScalingMatrixPresentFlag) {
            // skip scaling list
        }

        secondChromaQpIndexOffset =
            bitArray.readSignedExpGolombCodedInt()
    }

    return PpsData(
        ppsId,
        spsId,
        entropyCodingModeFlag,
        bottomFieldPicOrderInFramePresentFlag,
        numSliceGroupsMinus1,
        weightedPredFlag,
        weightedBipredIdc,
        picInitQpMinus26,
        chromaQpIndexOffset,
        deblockingFilterControlPresentFlag,
        constrainedIntraPredFlag,
        redundantPicCntPresentFlag,
        transform8x8ModeFlag,
        secondChromaQpIndexOffset
    )
}


