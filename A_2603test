2. Find PPS from csd0

fun findPpsNalUnit(data: ByteArray): ByteArray? {

    val prefixFlags = BooleanArray(3)

    var offset = 0

    while (offset < data.size) {

        val start = NalUnitUtil.findNalUnit(
            data,
            offset,
            data.size,
            prefixFlags
        )

        if (start >= data.size) break

        val type = NalUnitUtil.getNalUnitType(data, start)

        if (type == 8) {

            val next = NalUnitUtil.findNalUnit(
                data,
                start + 4,
                data.size,
                prefixFlags
            )

            return data.copyOfRange(start + 4, next)
        }

        offset = start + 4
    }

    return null
}


