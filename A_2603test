fun parsePpsFromCsd0(csd0: ByteArray) {

    val ppsNal = findPpsNalUnit(csd0)
        ?: return

    val pps = parsePpsNalUnit(ppsNal)

    println("ppsId=${pps.ppsId}")
    println("spsId=${pps.spsId}")
    println("entropyCodingMode=${pps.entropyCodingModeFlag}")
    println("bottomField=${pps.bottomFieldPicOrderInFramePresentFlag}")
    println("numSliceGroups=${pps.numSliceGroupsMinus1}")
    println("weightedPred=${pps.weightedPredFlag}")
    println("weightedBipred=${pps.weightedBipredIdc}")
    println("picInitQpMinus26=${pps.picInitQpMinus26}")
    println("chromaQpOffset=${pps.chromaQpIndexOffset}")
    println("deblocking=${pps.deblockingFilterControlPresentFlag}")
    println("constrained=${pps.constrainedIntraPredFlag}")
    println("redundantPicCnt=${pps.redundantPicCntPresentFlag}")
    println("transform8x8=${pps.transform8x8ModeFlag}")
    println("secondChromaOffset=${pps.secondChromaQpIndexOffset}")
}


