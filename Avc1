🧠 3. BitReader (core)

class BitReader(private val data: ByteArray) {
    private var byteOffset = 0
    private var bitOffset = 0

    fun readBit(): Int {
        val value = (data[byteOffset].toInt() shr (7 - bitOffset)) and 1
        bitOffset++
        if (bitOffset == 8) {
            bitOffset = 0
            byteOffset++
        }
        return value
    }

    fun readBits(n: Int): Int {
        var value = 0
        repeat(n) {
            value = (value shl 1) or readBit()
        }
        return value
    }

    fun readUE(): Int {
        var zeros = 0
        while (readBit() == 0) zeros++

        var value = 1
        repeat(zeros) {
            value = (value shl 1) or readBit()
        }

        return value - 1
    }

    fun readSE(): Int {
        val ueVal = readUE()
        return if (ueVal % 2 == 0) -(ueVal / 2) else (ueVal + 1) / 2
    }
}


