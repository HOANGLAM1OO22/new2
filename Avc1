🚀 1. Entry point – dùng với MediaFormat

fun extractPpsInfo(format: MediaFormat) {
    val csd0Buffer = format.getByteBuffer("csd-0") ?: return
    val csd0 = ByteArray(csd0Buffer.remaining())
    csd0Buffer.get(csd0)

    val (spsList, ppsList) = AvccParser.parseAvcc(csd0)

    println("SPS count = ${spsList.size}")
    println("PPS count = ${ppsList.size}")

    ppsList.forEachIndexed { index, pps ->
        val info = PpsParser.parse(pps)
        println("---- PPS $index ----")
        println(info)
    }
}


