🔥 6. PPS Parser (FULL – chuẩn H.264)

object PpsParser {

    fun parse(pps: ByteArray): PpsInfo {

        // remove NAL header
        val rbsp = removeEmulationBytes(pps.copyOfRange(1, pps.size))
        val br = BitReader(rbsp)

        val picParameterSetId = br.readUE()
        val seqParameterSetId = br.readUE()

        val entropyCodingModeFlag = br.readBit()
        br.readBit() // bottom_field_pic_order_in_frame_present_flag

        val numSliceGroups = br.readUE()

        if (numSliceGroups > 0) {
            val sliceGroupMapType = br.readUE()

            when (sliceGroupMapType) {
                0 -> {
                    for (i in 0..numSliceGroups) {
                        br.readUE()
                    }
                }

                2 -> {
                    for (i in 0 until numSliceGroups) {
                        br.readUE()
                        br.readUE()
                        br.readUE()
                    }
                }

                3, 4, 5 -> {
                    br.readBit()
                    br.readBit()
                    for (i in 0 until numSliceGroups) {
                        br.readUE()
                    }
                }

                6 -> {
                    val picSize = br.readUE()
                    val bits = ceilLog2(numSliceGroups + 1)
                    repeat(picSize) {
                        br.readBits(bits)
                    }
                }
            }
        }

        br.readUE() // num_ref_idx_l0_default_active_minus1
        br.readUE() // num_ref_idx_l1_default_active_minus1

        br.readBit() // weighted_pred_flag
        br.readBits(2) // weighted_bipred_idc

        br.readSE() // pic_init_qp_minus26
        br.readSE() // pic_init_qs_minus26
        br.readSE() // chroma_qp_index_offset

        val deblockingFlag = br.readBit() // 🎯

        return PpsInfo(
            picParameterSetId,
            seqParameterSetId,
            entropyCodingModeFlag,
            deblockingFlag
        )
    }

    private fun ceilLog2(x: Int): Int {
        var v = x - 1
        var r = 0
        while (v > 0) {
            v = v shr 1
            r++
        }
        return r
    }
}


