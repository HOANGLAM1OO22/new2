🧩 2. AVCC Parser (parse csd-0)

object AvccParser {

    fun parseAvcc(csd: ByteArray): Pair<List<ByteArray>, List<ByteArray>> {
        val spsList = mutableListOf<ByteArray>()
        val ppsList = mutableListOf<ByteArray>()

        var offset = 0

        offset += 4 // version + profile + compatibility + level

        val lengthSizeMinusOne = csd[offset].toInt() and 0x03
        offset++

        val numOfSps = csd[offset].toInt() and 0x1F
        offset++

        // SPS
        repeat(numOfSps) {
            val length = ((csd[offset].toInt() and 0xFF) shl 8) or
                    (csd[offset + 1].toInt() and 0xFF)
            offset += 2

            val sps = csd.copyOfRange(offset, offset + length)
            spsList.add(sps)
            offset += length
        }

        // PPS
        val numOfPps = csd[offset].toInt() and 0xFF
        offset++

        repeat(numOfPps) {
            val length = ((csd[offset].toInt() and 0xFF) shl 8) or
                    (csd[offset + 1].toInt() and 0xFF)
            offset += 2

            val pps = csd.copyOfRange(offset, offset + length)
            ppsList.add(pps)
            offset += length
        }

        return Pair(spsList, ppsList)
    }
}


