🧠 3. BitReader SAFE (fix crash)

class BitReader(private val data: ByteArray) {
    private var byteOffset = 0
    private var bitOffset = 0

    fun hasMoreBits(): Boolean {
        return byteOffset < data.size
    }

    fun readBit(): Int {
        if (!hasMoreBits()) throw RuntimeException("Out of bits")

        val value = (data[byteOffset].toInt() shr (7 - bitOffset)) and 1

        bitOffset++
        if (bitOffset == 8) {
            bitOffset = 0
            byteOffset++
        }

        return value
    }

    fun readBits(n: Int): Int {
        var value = 0
        repeat(n) {
            if (!hasMoreBits()) return value
            value = (value shl 1) or readBit()
        }
        return value
    }

    fun readUE(): Int {
        var zeros = 0

        while (hasMoreBits()) {
            val bit = readBit()
            if (bit == 0) zeros++ else break
        }

        var value = 1
        repeat(zeros) {
            if (!hasMoreBits()) return 0
            value = (value shl 1) or readBit()
        }

        return value - 1
    }

    fun readSE(): Int {
        val ueVal = readUE()
        return if (ueVal % 2 == 0) -(ueVal / 2) else (ueVal + 1) / 2
    }
}


