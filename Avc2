🧩 2. Split Annex-B (fix chuẩn)

fun splitAnnexB(data: ByteArray): List<ByteArray> {
    val result = mutableListOf<ByteArray>()
    var i = 0

    fun findStartCode(offset: Int): Int {
        for (j in offset until data.size - 3) {
            if (data[j] == 0.toByte() && data[j + 1] == 0.toByte()) {
                if (data[j + 2] == 1.toByte()) return j
                if (j + 3 < data.size && data[j + 2] == 0.toByte() && data[j + 3] == 1.toByte()) return j
            }
        }
        return -1
    }

    while (true) {
        val start = findStartCode(i)
        if (start < 0) break

        val next = findStartCode(start + 3)
        val end = if (next < 0) data.size else next

        val nalStart = if (data[start + 2] == 1.toByte()) start + 3 else start + 4
        result.add(data.copyOfRange(nalStart, end))

        i = end
    }

    return result
}


