fun safeParsePps(pps: ByteArray): PpsInfo? {
    return try {
        if (pps.size < 2) return null

        val rbsp = removeEmulationBytes(pps.copyOfRange(1, pps.size))
        val br = BitReader(rbsp)

        val ppsId = br.readUE()
        val spsId = br.readUE()

        val entropy = if (br.hasMoreBits()) br.readBit() else 0
        if (!br.hasMoreBits()) return PpsInfo(ppsId, spsId, entropy, -1)

        br.readBit() // bottom_field_pic_order...

        val numSliceGroups = if (br.hasMoreBits()) br.readUE() else 0

        if (numSliceGroups > 0 && br.hasMoreBits()) {
            val mapType = br.readUE()
            when (mapType) {
                0 -> repeat(numSliceGroups + 1) { br.readUE() }
                2 -> repeat(numSliceGroups) {
                    br.readUE(); br.readUE(); br.readUE()
                }
                3, 4, 5 -> {
                    br.readBit()
                    br.readBit()
                    repeat(numSliceGroups) { br.readUE() }
                }
                6 -> {
                    val picSize = br.readUE()
                    val bits = ceilLog2(numSliceGroups + 1)
                    repeat(picSize) { br.readBits(bits) }
                }
            }
        }

        if (br.hasMoreBits()) br.readUE()
        if (br.hasMoreBits()) br.readUE()

        if (br.hasMoreBits()) br.readBit()
        if (br.hasMoreBits()) br.readBits(2)

        if (br.hasMoreBits()) br.readSE()
        if (br.hasMoreBits()) br.readSE()
        if (br.hasMoreBits()) br.readSE()

        val deblocking = if (br.hasMoreBits()) br.readBit() else -1

        PpsInfo(ppsId, spsId, entropy, deblocking)

    } catch (e: Exception) {
        null
    }
}

fun ceilLog2(x: Int): Int {
    var v = x - 1
    var r = 0
    while (v > 0) {
        v = v shr 1
        r++
    }
    return r
}


