🧹 4. Remove emulation bytes

fun removeEmulationBytes(data: ByteArray): ByteArray {
    val out = ArrayList<Byte>()
    var i = 0

    while (i < data.size) {
        if (i + 2 < data.size &&
            data[i] == 0.toByte() &&
            data[i + 1] == 0.toByte() &&
            data[i + 2] == 3.toByte()
        ) {
            out.add(0)
            out.add(0)
            i += 3
        } else {
            out.add(data[i])
            i++
        }
    }

    return out.toByteArray()
}


