2️⃣ Parse VUI

private fun parseVui(br: BitReader): VuiInfo {

        var aspectRatioIdc: Int? = null
        var sarWidth: Int? = null
        var sarHeight: Int? = null
        var videoFullRangeFlag: Boolean? = null
        var colourPrimaries: Int? = null
        var transferCharacteristics: Int? = null
        var matrixCoeffs: Int? = null
        var numUnitsInTick: Long? = null
        var timeScale: Long? = null

        val aspectRatioInfoPresentFlag = br.readBits(1)
        if (aspectRatioInfoPresentFlag == 1) {
            aspectRatioIdc = br.readBits(8)
            if (aspectRatioIdc == 255) {
                sarWidth = br.readBits(16)
                sarHeight = br.readBits(16)
            }
        }

        val overscanInfoPresentFlag = br.readBits(1)
        if (overscanInfoPresentFlag == 1) {
            br.readBits(1)
        }

        val videoSignalTypePresentFlag = br.readBits(1)
        if (videoSignalTypePresentFlag == 1) {
            br.readBits(3)
            videoFullRangeFlag = br.readBits(1) == 1

            val colourDescriptionPresentFlag = br.readBits(1)
            if (colourDescriptionPresentFlag == 1) {
                colourPrimaries = br.readBits(8)
                transferCharacteristics = br.readBits(8)
                matrixCoeffs = br.readBits(8)
            }
        }

        val chromaLocInfoPresentFlag = br.readBits(1)
        if (chromaLocInfoPresentFlag == 1) {
            br.readUE()
            br.readUE()
        }

        br.readBits(1)
        br.readBits(1)
        br.readBits(1)

        val timingInfoPresentFlag = br.readBits(1)
        if (timingInfoPresentFlag == 1) {
            numUnitsInTick = br.readBits(32).toLong()
            timeScale = br.readBits(32).toLong()
        }

        return VuiInfo(
            aspectRatioIdc,
            sarWidth,
            sarHeight,
            videoFullRangeFlag,
            colourPrimaries,
            transferCharacteristics,
            matrixCoeffs,
            numUnitsInTick,
            timeScale
        )
    }


