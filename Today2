1️⃣ HevcSpsParser

object HevcSpsParser {

    data class SpsInfo(
        val width: Int,
        val height: Int,
        val profileIdc: Int,
        val levelIdc: Int,
        val chromaFormatIdc: Int,
        val bitDepthLuma: Int,
        val bitDepthChroma: Int,
        val vui: VuiInfo?
    )

    data class VuiInfo(
        val aspectRatioIdc: Int?,
        val sarWidth: Int?,
        val sarHeight: Int?,
        val videoFullRangeFlag: Boolean?,
        val colourPrimaries: Int?,
        val transferCharacteristics: Int?,
        val matrixCoeffs: Int?,
        val numUnitsInTick: Long?,
        val timeScale: Long?
    )

    fun parse(data: ByteArray): SpsInfo {

        val br = BitReader(data)

        // ---- NAL HEADER ----
        br.readBits(16)

        br.readBits(4) // sps_video_parameter_set_id
        val maxSubLayersMinus1 = br.readBits(3)
        br.readBits(1) // temporal nesting flag

        val profileTier = parseProfileTierLevel(br, maxSubLayersMinus1)

        br.readUE() // sps_seq_parameter_set_id

        val chromaFormatIdc = br.readUE()
        if (chromaFormatIdc == 3) {
            br.readBits(1)
        }

        val width = br.readUE()
        val height = br.readUE()

        val conformanceWindowFlag = br.readBits(1)
        if (conformanceWindowFlag == 1) {
            br.readUE()
            br.readUE()
            br.readUE()
            br.readUE()
        }

        val bitDepthLumaMinus8 = br.readUE()
        val bitDepthChromaMinus8 = br.readUE()

        br.readUE() // log2_max_pic_order_cnt_lsb_minus4
        br.readBits(1) // sps_sub_layer_ordering_info_present_flag

        for (i in 0..maxSubLayersMinus1) {
            br.readUE()
            br.readUE()
            br.readUE()
        }

        br.readUE()
        br.readUE()
        br.readUE()
        br.readUE()
        br.readUE()
        br.readUE()

        br.readBits(1) // scaling_list_enabled_flag
        br.readBits(1) // amp_enabled_flag
        br.readBits(1) // sample_adaptive_offset_enabled_flag

        val pcmEnabledFlag = br.readBits(1)
        if (pcmEnabledFlag == 1) {
            br.readBits(4)
            br.readBits(4)
            br.readUE()
            br.readUE()
            br.readBits(1)
        }

        val numShortTermRefPicSets = br.readUE()
        for (i in 0 until numShortTermRefPicSets) {
            skipShortTermRefPicSet(br)
        }

        val longTermRefPicsPresentFlag = br.readBits(1)
        if (longTermRefPicsPresentFlag == 1) {
            val numLongTermRefPics = br.readUE()
            for (i in 0 until numLongTermRefPics) {
                br.readBits(16)
                br.readBits(1)
            }
        }

        br.readBits(1)
        br.readBits(1)

        val vuiParametersPresentFlag = br.readBits(1)

        val vui = if (vuiParametersPresentFlag == 1) {
            parseVui(br)
        } else null

        return SpsInfo(
            width = width,
            height = height,
            profileIdc = profileTier.profileIdc,
            levelIdc = profileTier.levelIdc,
            chromaFormatIdc = chromaFormatIdc,
            bitDepthLuma = bitDepthLumaMinus8 + 8,
            bitDepthChroma = bitDepthChromaMinus8 + 8,
            vui = vui
        )
    }


